{
  "name": "@kestrel/contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./errors": {
      "types": "./dist/errors.d.ts",
      "default": "./dist/errors.js"
    },
    "./domain": {
      "types": "./dist/domain.d.ts",
      "default": "./dist/domain.js"
    },
    "./schemas": {
      "types": "./dist/schemas.d.ts",
      "default": "./dist/schemas.js"
    },
    "./time": {
      "types": "./dist/time.d.ts",
      "default": "./dist/time.js"
    },
    "./jsonschema": {
      "types": "./dist/jsonschema.d.ts",
      "default": "./dist/jsonschema.js"
    },
    "./integrations": {
      "types": "./dist/integrations.d.ts",
      "default": "./dist/integrations.js"
    },
    "./webmcp-tools": {
      "types": "./dist/webmcp-tool-catalog.d.ts",
      "default": "./dist/webmcp-tool-catalog.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/node": "26.4.1",
    "ajv": "8.20.0",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}

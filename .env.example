# Kestrel backend/API environment
# Copy to .env (never commit .env) and fill values. No real secrets belong here.

# PostgreSQL connection string (local dev or Neon)
DATABASE_URL=postgresql://localhost:5432/kestrel_dev

# Host/port for the Fastify API
API_HOST=127.0.0.1
API_PORT=8787

# Comma-separated CORS allowlist of frontend origins (no trailing slashes)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Secret used to sign the demo session cookie (32+ chars). REQUIRED outside local dev.
SESSION_SECRET=change-me-32-chars-minimum-random-string

# "development" | "production" | "test"
NODE_ENV=development

# Default actor id used by the demo session (seeded user)
DEMO_USER_ID=usr_alex

# Optional: seed the golden demo automatically on API start when the DB is empty
AUTO_SEED=false

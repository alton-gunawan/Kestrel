{
  "name": "kestrel",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.14.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@astryxdesign/core",
      "esbuild"
    ]
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "pnpm --filter @kestrel/contracts build && pnpm --parallel --filter @kestrel/api --filter @kestrel/web dev",
    "dev:api": "pnpm --filter @kestrel/contracts build && pnpm --filter @kestrel/api dev",
    "dev:web": "pnpm --filter @kestrel/web dev",
    "build": "pnpm --filter @kestrel/contracts build && pnpm -r --filter !@kestrel/contracts build",
    "build:web": "pnpm --filter @kestrel/contracts build && pnpm --filter @kestrel/web build",
    "build:api": "pnpm --filter @kestrel/contracts build && pnpm --filter @kestrel/api build",
    "preview": "pnpm --filter @kestrel/web preview",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "test": "pnpm --filter @kestrel/contracts test && pnpm --filter @kestrel/contracts build && pnpm --filter @kestrel/api test",
    "test:watch": "pnpm --filter @kestrel/contracts build && pnpm --filter @kestrel/api test:watch",
    "test:e2e": "pnpm --filter @kestrel/e2e test",
    "test:a11y": "pnpm --filter @kestrel/e2e test:a11y",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "db:generate": "pnpm --filter @kestrel/api db:generate",
    "db:migrate": "pnpm --filter @kestrel/api db:migrate",
    "db:seed": "pnpm --filter @kestrel/api db:seed",
    "audit:deps": "node scripts/audit-deps.mjs"
  },
  "devDependencies": {
    "@babel/core": "8.0.1",
    "@types/node": "26.4.1",
    "eslint": "10.9.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.69.0"
  }
}
